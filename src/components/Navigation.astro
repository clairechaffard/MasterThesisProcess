---
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const links = [
  { href: base, label: 'Home' },
  { href: `${base}topic`, label: 'Topic' },
  { href: `${base}notes`, label: 'Notes' },
  { href: `${base}references`, label: 'References' },
  { href: `${base}archive`, label: 'Visual archive' },
  { href: `${base}moodboards`, label: 'Moodboards' },
  { href: `${base}about`, label: 'About' },
  
];
---
<header class="site-header">
  <a class="wordmark" href={base}>Claire Chaffard<span> / MASTER THESIS </span></a>
  <nav aria-label="Main navigation">
    {links.map((link) => <a href={link.href}>{link.label}</a>)}
  </nav>
</header>
