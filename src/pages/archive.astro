---
import MainLayout from '../components/MainLayout.astro';
---
<MainLayout title="Visual archive">
  <section class="page-intro"><p class="eyebrow">03 / Collection</p><h1>Visual archive<span>.</span></h1><p class="intro">A loose collection of images, screenshots, photographs and visual fragments. Add images to <code>public/images/</code> and place them in this grid.</p></section>
  <div class="image-grid">
    <figure><div class="image-placeholder">IMAGE 01</div><figcaption>Caption / source / date</figcaption></figure>
    <figure><div class="image-placeholder tall">IMAGE 02</div><figcaption>Caption / source / date</figcaption></figure>
    <figure><div class="image-placeholder">IMAGE 03</div><figcaption>Caption / source / date</figcaption></figure>
    <figure><div class="image-placeholder">IMAGE 04</div><figcaption>Caption / source / date</figcaption></figure>
  </div>
</MainLayout>
