---
import { getCollection } from 'astro:content';
import MainLayout from '../components/MainLayout.astro';
import EntryCard from '../components/EntryCard.astro';

const notes = (await getCollection('notes')).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0,3);
const refs = (await getCollection('references')).slice(0,3);
---
<MainLayout>
  <section class="hero">
    <p class="eyebrow">A living research archive · 2026—2027</p>
    <h1>Thinking through<br /><em>images, texts & fragments.</em></h1>
    <p class="intro">An evolving space to collect observations, references, conversations and visual material around my master thesis.</p>
    <a class="read-link" href="/about">About this research ↗</a>
  </section>

  <section class="section-block">
    <div class="section-heading"><p class="eyebrow">01 / Recent writing</p><a href="/notes">All notes ↗</a></div>
    <div class="card-grid">
      {notes.map((entry) => <EntryCard title={entry.data.title} href={`/notes/${entry.slug}`} meta={`${entry.data.category} · ${entry.data.date.toLocaleDateString('en-GB')}`} excerpt={entry.data.excerpt} />)}
    </div>
  </section>

  <section class="section-block">
    <div class="section-heading"><p class="eyebrow">02 / Collected references</p><a href="/references">All references ↗</a></div>
    <div class="card-grid">
      {refs.map((entry) => <EntryCard title={entry.data.title} href={`/references/${entry.slug}`} meta={entry.data.kind} excerpt={entry.data.note} />)}
    </div>
  </section>

  <section class="portal-grid">
    <a href="/archive"><span>03</span><strong>Visual archive</strong><small>Images, screenshots, traces</small></a>
    <a href="/moodboards"><span>04</span><strong>Moodboards</strong><small>Visual constellations & themes</small></a>
    <a href="/about"><span>05</span><strong>Research</strong><small>Questions, methods, directions</small></a>
  </section>
</MainLayout>
