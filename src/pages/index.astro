---
import { getCollection } from 'astro:content';
import MainLayout from '../components/MainLayout.astro';
import EntryCard from '../components/EntryCard.astro';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const notes = (await getCollection('notes')).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0,3);
const refs = (await getCollection('references')).slice(0,3);
---
<MainLayout>
  <section class="hero">
    <p class="eyebrow">2026-2027</p>
    <h1>Master's thesis<br/><em> Claire and her Journey in Media Design </em></h1>
    <p class="intro"></p>
    <a class="read-link" href={`${base}about`}>About this research ↗</a>
  </section>

  <section class="section-block">
    <div class="section-heading"><p class="eyebrow">01 / Designing the question</p><a href={`${base}topic/`}>See the process ↗</a></div>
    <div class="card-grid">
      {notes.map((entry) => <EntryCard title={entry.data.title} href={`${base}notes/${entry.slug}`} meta={`${entry.data.category} · ${entry.data.date.toLocaleDateString('en-GB')}`} excerpt={entry.data.excerpt} />)}
    </div>
  </section>

  <section class="section-block">
    <div class="section-heading"><p class="eyebrow">02 / Recent writing</p><a href={`${base}notes`}>All notes ↗</a></div>
    <div class="card-grid">
      {notes.map((entry) => <EntryCard title={entry.data.title} href={`${base}notes/${entry.slug}`} meta={`${entry.data.category} · ${entry.data.date.toLocaleDateString('en-GB')}`} excerpt={entry.data.excerpt} />)}
    </div>
  </section>

  <section class="section-block">
    <div class="section-heading"><p class="eyebrow">03 / Collected references</p><a href={`${base}references`}>All references ↗</a></div>
    <div class="card-grid">
      {refs.map((entry) => <EntryCard title={entry.data.title} href={`${base}references/${entry.slug}`} meta={entry.data.kind} excerpt={entry.data.note} />)}
    </div>
  </section>

  <section class="portal-grid">
    <a href={`${base}archive`}><span>03</span><strong>Visual archive</strong><small>Images, screenshots, traces</small></a>
    <a href={`${base}moodboards`}><span>04</span><strong>Moodboards</strong><small>Visual constellations & themes</small></a>
    <a href={`${base}about`}><span>05</span><strong>Research</strong><small>Questions, methods, directions</small></a>
  </section>
</MainLayout>
